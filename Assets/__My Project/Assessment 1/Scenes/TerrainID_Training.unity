  m_Script: {fileID: 11500000, guid: 0e1155299ec3e4796b219dc81bd33bb4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LandNav.InfoSign
  title: TERRAIN IDENTIFICATION
  body: 'You carry four flags: <b>Blue, Red, Yellow, Green</b>.

    Your map shows
    where each one belongs. Use the contours to work out what feature is at each
    spot, walk there, and plant that flag.


    A sign on the flag tells you if
    you were right. Pull a flag up and try again whenever you like.


    <b>VR</b>:
    left stick walk, right stick turn, A switch flag, trigger plant, B pull up.

    <b>Keyboard</b>:
    WASD walk, mouse look, M map, 1-4 flag, F plant, G pull up.


    Take breaks.
    Remove the headset if you feel unwell.'
  size: {x: 1.5, y: 1.15}
  height: 1.55
  postMaterial: {fileID: 2100000, guid: 7506e673fcd6c4403ad02077e3366bea, type: 2}
